// revu — GitHub review requests, on exact2. The screens follow the Claude
// Design file "PR Review Menu Bar" (1a onboarding, 1b pending list, 1c quick
// look, 1d review in progress, 1e results, 1f skill settings) on the Expo
// design-system tokens; the window is sized like the design's popover.
// The data is app.ts: device-flow sign-in, polling, seen-state, PR details,
// skill rules, and the sidecar's review jobs.

routes nav
  inbox "/"
    pr "/pr/:owner/:name/:number"
      review "/pr/:owner/:name/:number/review"
    settings "/settings"

shape Time
  epochAtZero: number

shape Session
  signedIn: bool
  login: string
  error: string

shape DeviceCode
  stamp: number
  ok: bool
  userCode: string
  verificationUri: string
  deviceCode: string
  expiresAt: number
  error: string

shape Browser
  stamp: number
  ok: bool
  state: string
  url: string
  error: string

shape Grant
  stamp: number
  status: string
  login: string
  error: string

shape Review
  id: string
  owner: string
  name: string
  repo: string
  number: number
  title: string
  url: string
  author: string
  requestedAt: string
  age: string
  unread: bool
  team: string
  ci: string
  ciLabel: string

shape Inbox
  ready: bool
  login: string
  unread: number
  total: number
  mineCount: number
  teamCount: number
  polledAt: string
  error: string
  mine: list<Review>
  team: list<Review>

shape ChangedFile
  path: string
  additions: number
  deletions: number

shape PrDetail
  ready: bool
  id: string
  repo: string
  number: number
  title: string
  url: string
  author: string
  authorAvatar: string
  baseRef: string
  headRef: string
  headSha: string
  baseSha: string
  ci: string
  ciLabel: string
  files: number
  additions: number
  deletions: number
  changed: list<ChangedFile>
  body: string
  skill: string
  skillRule: string
  error: string

shape Started
  stamp: number
  id: string
  error: string

shape Comment
  index: number
  severity: string
  path: string
  line: number
  title: string
  body: string
  chosen: bool
  hunk: list<HunkLine>

shape Job
  ready: bool
  id: string
  status: string
  skill: string
  agent: string
  step: number
  progress: number
  elapsed: string
  startedAt: string
  finishedAt: string
  lastOutputAt: string
  repo: string
  number: number
  title: string
  log: list<string>
  calls: number
  summary: string
  verdict: string
  hasResult: bool
  comments: list<Comment>
  chosenCount: number
  posted: bool
  postedUrl: string
  postedCount: number
  error: string

shape Elapsed
  text: string
  quiet: number
  quietText: string

shape Agents
  current: string
  model: string
  claudeAvailable: bool
  codexAvailable: bool
  claudePath: string
  codexPath: string

shape AgentSet
  stamp: number
  ok: bool

shape Toggled
  stamp: number

shape Posted
  stamp: number
  ok: bool
  url: string
  count: number
  error: string

shape Cancelled
  stamp: number
  ok: bool

shape Rule
  pattern: string
  skill: string

shape SkillFile
  name: string
  path: string
  description: string
  usedBy: string

shape SkillLine
  n: number
  text: string
  heading: bool

shape SkillSettings
  reachable: bool
  rules: list<Rule>
  skills: list<SkillFile>
  selected: string
  usedBy: string
  path: string
  content: string
  lines: list<SkillLine>
  error: string

shape RulesResult
  stamp: number
  error: string

shape SavedSkill
  stamp: number
  ok: bool
  error: string

shape SkillMatch
  skill: string
  pattern: string

shape SidecarStatus
  reachable: bool
  runner: string
  detail: string

shape NotifyStatus
  available: bool
  permission: string
  pending: number

shape Announced
  stamp: number
  count: number
  error: string

shape Actions
  stamp: number
  applied: list<string>

shape Seen
  stamp: number
  id: string

shape Tray
  ok: bool

shape WindowRole
  kind: string
  arg: string

shape HunkLine
  kind: string
  oldNo: number
  newNo: number
  text: string
  target: bool

shape Opened
  stamp: number
  ok: bool

// --- Expo design-system tokens (colors_and_type.css, light) ---------------
// fg-default #11181c · fg-secondary #596068 · fg-tertiary #687076 ·
// fg-disabled #c9d1d9 · border-default #e1e4e8 · border-subtle #eaecf0 ·
// border-strong #d7dbdf · bg-subtle #f9fafb · bg-element #f5f5f7 ·
// bg-hover #f0f1f2 · bg-active #eaecf0 · gray-900 #11181c · gray-400 #c9d1d9

// Design 1d: a spinner on the running step, a green check on a done one.
keyframes spin
  from rotate=0
  to rotate=360

// A skeleton's sheen (design: `shimmer`): a light band sweeping across.
keyframes shimmer
  from translate="-160px 0px"
  to translate="400px 0px"

style Surface
  width="100%" height="100%" box-sizing="border-box" background-color="light-dark(#ffffff, #0b0f14)" color="light-dark(#11181c, #e6edf3)" font-family="system-ui" font-size=13

style Header
  padding-top=14 padding-right=16 padding-bottom=10 padding-left=16 justify-content="space-between" align-items="center"

style HeaderTitle
  font-size=15 font-weight=600

style IconBtn
  display="flex" flex-direction="row" width=28 height=28 border-radius=6 align-items="center" justify-content="center" background-color="transparent" border-width=0 padding=0

style Chip
  display="flex" flex-direction="row" height=26 padding-left=10 padding-right=10 border-radius=6 font-size=12 font-weight=500 color="light-dark(#596068, #9aa4ae)" align-items="center" gap=6 background-color="transparent" border-width=0

style ChipOn
  display="flex" flex-direction="row" height=26 padding-left=10 padding-right=10 border-radius=6 font-size=12 font-weight=500 color="light-dark(#11181c, #e6edf3)" align-items="center" gap=6 background-color="light-dark(#eaecf0, #252932)" border-width=0

style Divider
  height=1 background-color="light-dark(#eaecf0, #252932)" width="100%"

style SectionLabel
  font-size=11 letter-spacing=0.9 text-transform="uppercase" color="light-dark(#687076, #6e7781)" font-weight=600

style Mono
  font-family="ui-monospace" font-size=12

style MonoLabel
  font-family="ui-monospace" font-size=12 color="light-dark(#687076, #6e7781)"

style Secondary
  font-size=12 color="light-dark(#596068, #9aa4ae)"

style Tertiary
  font-size=12 color="light-dark(#687076, #6e7781)"

style Primary
  display="flex" flex-direction="row" height=36 border-radius=6 background-color="light-dark(#11181c, #ffffff)" color="light-dark(#ffffff, #0b0f14)" font-size=14 font-weight=500 align-items="center" justify-content="center" gap=8 border-width=0 padding-left=14 padding-right=14

style PrimarySm
  display="flex" flex-direction="row" height=32 border-radius=6 background-color="light-dark(#11181c, #ffffff)" color="light-dark(#ffffff, #0b0f14)" font-size=13 font-weight=500 align-items="center" justify-content="center" gap=6 border-width=0 padding-left=14 padding-right=14

style Outline
  display="flex" flex-direction="row" height=32 padding-left=12 padding-right=12 border-radius=6 border-style="solid" border-width=1 border-color="light-dark(#e1e4e8, #1f242c)" background-color="light-dark(#ffffff, #0b0f14)" font-size=13 font-weight=500 color="light-dark(#11181c, #e6edf3)" align-items="center" justify-content="center" gap=6

style OutlineSm
  display="flex" flex-direction="row" height=26 padding-left=8 padding-right=8 border-radius=6 border-style="solid" border-width=1 border-color="light-dark(#e1e4e8, #1f242c)" background-color="light-dark(#ffffff, #0b0f14)" font-size=12 font-weight=500 color="light-dark(#11181c, #e6edf3)" align-items="center" justify-content="center" gap=5 flex-shrink=0

style Ghost
  display="flex" flex-direction="row" height=32 padding-left=12 padding-right=12 border-radius=6 font-size=13 font-weight=500 color="light-dark(#596068, #9aa4ae)" align-items="center" justify-content="center" background-color="transparent" border-width=0

style Field
  height=30 border-style="solid" border-width=1 border-color="light-dark(#e1e4e8, #1f242c)" border-radius=6 padding-left=10 padding-right=10 font-family="ui-monospace" font-size=12 color="light-dark(#11181c, #e6edf3)" background-color="light-dark(#ffffff, #0b0f14)" width="100%" box-sizing="border-box"

style Card
  border-style="solid" border-width=1 border-color="light-dark(#e1e4e8, #1f242c)" background-color="light-dark(#f9fafb, #111418)" border-radius=8 padding=12 gap=6

style Row
  display="flex" flex-direction="row" gap=12 padding-top=10 padding-right=16 padding-bottom=10 padding-left=16 align-items="flex-start" width="100%" box-sizing="border-box" background-color="transparent" border-width=0 text-align="left"

style Dot
  width=8 height=8 border-radius=9999 margin-top=6 flex-shrink=0

style Error
  font-size=12 color="light-dark(rgb(207, 34, 46), #ff7a7a)"

style Tag
  font-size=10 font-weight=600 letter-spacing=0.6 padding-top=1 padding-bottom=1 padding-left=6 padding-right=6 border-radius=4

style Tab
  display="flex" flex-direction="row" height=28 padding-left=12 padding-right=12 border-radius=6 align-items="center" justify-content="center" font-size=12 font-weight=500 color="light-dark(#596068, #9aa4ae)" background-color="transparent" border-width=0

style TabOn
  display="flex" flex-direction="row" height=28 padding-left=12 padding-right=12 border-radius=6 align-items="center" justify-content="center" font-size=12 font-weight=500 color="light-dark(#11181c, #e6edf3)" background-color="light-dark(#eaecf0, #252932)" border-width=0

component Revu
  state tick = 0
  state nowMs = 0
  state pollMs = 0
  state filter = "all"
  state settingsTab = "skills"
  state testRepo = ""
  state newPattern = ""
  state newSkill = ""
  state skillDraft = ""
  state skillEditing = false
  state selectedSkill = ""
  state selectedFinding = 0
  state modelDraft = ""
  state secMs = 0
  state doneAnnounced = ""
  state verdict = ""
  state browserOpened = ""

  // @ref exact2 LLP 1027.000.000 — the date is a host fact; now() is ms since launch.
  resource time = exactTime() as shape Time
  resource session = currentSession() as shape Session
  // Re-asked every 5 s for the first minute (the app starts the sidecar
  // itself, LLP 0007), then every minute with the inbox.
  derive sidecarTick = tick < 12 ? tick : 12
  resource sidecar = sidecarStatus(sidecarTick, pollMs) as shape SidecarStatus
  resource notifications = notificationStatus() as shape NotifyStatus
  // Re-asked when the module announces a user's answer; the inbox depends on
  // its stamp so a "Mark read" from a banner shows at once.
  resource actions = notificationActions(nowMs) as shape Actions
  // pollMs moves once a minute (and on Refresh), not every clock tick.
  resource inbox = reviewRequests(session.login, pollMs, time.epochAtZero, actions.stamp) as shape Inbox
  resource detail = prDetail(top(nav).params.owner, top(nav).params.name, top(nav).params.number, rulesStamp) as shape PrDetail
  resource job = reviewJob(jobId, tick, time.epochAtZero, toggledStamp, postedStamp) as shape Job
  // The elapsed time ticks every second while a review runs (design 1d).
  resource elapsedNow = elapsedSince(job.startedAt, job.finishedAt, job.lastOutputAt, secMs) as shape Elapsed
  // The local agent that runs reviews (LLP 0004): Settings ▸ Model.
  resource agents = agentSettings(agentStamp) as shape Agents
  resource skills = skillSettings(selectedSkill, rulesStamp, savedStamp) as shape SkillSettings
  resource testMatch = matchSkill(testRepo, rulesStamp) as shape SkillMatch
  // The menu bar item (LLP 0006): the pending count, a spinner while reviewing.
  resource tray = trayState(inbox.total, reviewing) as shape Tray
  // Which window this session draws (LLP 0006 D2): the popover, or "settings".
  resource role = windowRole() as shape WindowRole

  mutation browser as shape Browser
  mutation device as shape DeviceCode refreshes session
  mutation grant as shape Grant refreshes session, inbox
  mutation seen as shape Seen refreshes inbox
  mutation signout as shape Session refreshes session, inbox
  mutation permission as shape NotifyStatus refreshes notifications
  mutation announced as shape Announced
  mutation started as shape Started
  mutation cancelled as shape Cancelled
  mutation rules as shape RulesResult
  mutation saved as shape SavedSkill
  mutation opened as shape Opened
  mutation agentSet as shape AgentSet
  mutation toggled as shape Toggled
  mutation postResult as shape Posted
  mutation reviewOpened as shape Opened
  mutation doneNotice as shape Opened

  derive signedIn = session.signedIn
  derive granted = match grant { case some(g) => g.status == "ok", case none => false }
  // The popover's job is the one it started; a review window's is its argument.
  derive jobId = role.kind == "review" ? role.arg : match started { case some(s) => s.id, case none => "" }
  derive agentStamp = match agentSet { case some(a) => a.stamp, case none => 0 }
  derive toggledStamp = match toggled { case some(t) => t.stamp, case none => 0 }
  derive postedStamp = match postResult { case some(p) => p.stamp, case none => 0 }
  derive posting = pending(postResult)
  derive rulesStamp = match rules { case some(r) => r.stamp, case none => 0 }
  derive savedStamp = match saved { case some(s) => s.stamp, case none => 0 }
  // The code's own deadline, so an expiry shows even if a poll is missed.
  derive codeExpired = match device { case some(d) => d.ok and nowMs > d.expiresAt, case none => false }
  derive isPopover = role.kind == "popover"
  // A settings or review window draws its own screen whatever its nav says; wide is its layout.
  derive screen = isPopover ? top(nav).name : role.kind == "review" ? "review-window" : "settings"
  derive wide = not isPopover
  derive prOwner = top(nav).params.owner
  derive prName = top(nav).params.name
  derive prNumber = top(nav).params.number
  derive reviewing = job.status == "queued" or job.status == "preparing" or job.status == "running"

  // The button: the browser flow through the sidecar (LLP 0002 r4); the
  // device code is started alongside as the fallback shown beneath it.
  action startSignIn writes device, browser, grant, nowMs
    nowMs = time.epochAtZero + now()
    grant = none
    send browser = browserStart()
    send device = deviceStart(nowMs)
  action openBrowser writes opened
    match browser
      case some(b)
        if b.ok
          openURL(b.url)
      case none
        opened = none
  action cancelSignIn writes device, browser, grant
    device = none
    browser = none
    grant = none
  action doSignOut writes signout, device, browser, grant, nav
    device = none
    browser = none
    grant = none
    nav = open(nav, "/")
    send signout = signOut()
  action markRead(id: string) writes seen
    send seen = markSeen(id)
  action refreshNow writes nowMs, pollMs, announced
    nowMs = time.epochAtZero + now()
    pollMs = nowMs
    send announced = announceNew(nowMs)
  action askPermission writes permission
    send permission = requestNotificationPermission()
  action setFilter(f: string) writes filter
    filter = f
  // Opening a request reads it; the banner's "Mark read" does the same.
  action openPr(id: string, owner: string, name: string, number: string) writes nav, seen, selectedFinding
    selectedFinding = 0
    send seen = markSeen(id)
    nav = push(nav, path("pr", owner, name, number))
  action goBack writes nav
    nav = back(nav)
  // A page outside the app: the host's browser (Contract's `openURL`).
  action openLink(url: string)
    openURL(url)
  // With the menu bar (the tray answers), settings is a window of its own;
  // elsewhere (web) it is a screen.
  action openSettings writes nav, opened
    if tray.ok
      send opened = openWindow("settings", "")
    else
      nav = push(nav, "/settings")
  action setSettingsTab(t: string) writes settingsTab
    settingsTab = t
  action runReview writes started, nav, selectedFinding
    selectedFinding = 0
    send started = startReview(detail.id, detail.skill)
    nav = push(nav, path("review", prOwner, prName, prNumber))
  action cancelReview writes cancelled, nav
    send cancelled = cancelReview(jobId)
    nav = back(nav)
  action selectFinding(i: number) writes selectedFinding
    selectedFinding = i
  action toggleComment(i: number) writes toggled
    send toggled = toggleComment(jobId, i)
  action postComments writes postResult
    send postResult = postComments(jobId, verdict)
  action setVerdict(v: string) writes verdict
    verdict = v
  action openReviewWindow writes reviewOpened
    send reviewOpened = openWindow("review", jobId)
  action chooseAgent(name: string) writes agentSet
    send agentSet = setAgent(name)
  action setModelDraft(v: string) writes modelDraft
    modelDraft = v
  action saveModel writes agentSet
    send agentSet = setModel(modelDraft)
  action setTestRepo(v: string) writes testRepo
    testRepo = v
  action setNewPattern(v: string) writes newPattern
    newPattern = v
  action setNewSkill(v: string) writes newSkill
    newSkill = v
  action addRule writes rules, newPattern, newSkill
    send rules = addRule(newPattern, newSkill)
    newPattern = ""
    newSkill = ""
  action removeRule(pattern: string) writes rules
    send rules = removeRule(pattern)
  action selectSkill(name: string) writes selectedSkill, skillEditing, skillDraft
    selectedSkill = name
    skillEditing = false
    skillDraft = ""
  action editSkill writes skillEditing, skillDraft
    skillEditing = true
    skillDraft = skills.content
  action changeSkill(v: string) writes skillDraft
    skillDraft = v
  action revertSkill writes skillEditing, skillDraft
    skillEditing = false
    skillDraft = ""
  action saveSkill writes saved, skillEditing
    send saved = saveSkill(skills.selected, skillDraft)
    skillEditing = false
  // One 5s clock: while a device code is out and not yet granted, poll the
  // grant; once signed in, poll the inbox every 12th tick (60s) and announce
  // what is new on the tick after.
  action clock writes tick, grant, nowMs, pollMs, announced
    tick = tick + 1
    nowMs = time.epochAtZero + now()
    if tick % 12 == 0 and isPopover
      pollMs = nowMs
    if signedIn
      if tick % 12 == 1 and isPopover
        send announced = announceNew(nowMs)
      if pollMs == 0
        pollMs = nowMs
    else
      match browser
        case some(b)
          if b.ok and not granted and tick % 2 == 0
            send grant = browserPoll(b.state)
        case none
          tick = tick
      match device
        case some(d)
          if d.ok and not granted and not codeExpired and tick % 2 == 1
            send grant = devicePoll(d.deviceCode, nowMs)
        case none
          tick = tick

  action second writes secMs, doneAnnounced, reviewOpened, doneNotice, browserOpened
    if reviewing
      secMs = time.epochAtZero + now()
    // The browser opens by itself once the sidecar has the sign-in URL.
    match browser
      case some(b)
        if b.ok and browserOpened != b.state
          browserOpened = b.state
          openURL(b.url)
      case none
        browserOpened = browserOpened
    if isPopover and job.ready and job.status == "done" and doneAnnounced != jobId
      doneAnnounced = jobId
      send doneNotice = notifyDone(jobId, `${prOwner}/${prName} #${prNumber}`, length(job.comments))
      send reviewOpened = openWindow("review", jobId)

  task poll mount
    every(5000, clock)
  task ticker mount
    every(1000, second)

  view
    main testId="revu" navigationKey=`${top(nav).id}` navigationBack="goBack" class=Surface display="flex" flex-direction="column" overflow="hidden"
      revu-notifier width=0 height=0 testId="notifier"

      // ---- 1a Onboarding — connect GitHub ------------------------------
      when not signedIn
        column padding-top=32 padding-right=28 padding-bottom=24 padding-left=28 gap=24 testId="onboarding"
          column width=48 height=48 border-radius=12 background-color="light-dark(#11181c, #ffffff)" align-items="center" justify-content="center"
            Icon(name="git-pull-request", size=24, color="light-dark(#ffffff, #0b0f14)")
          column gap=8
            text "Connect your GitHub account" font-size=20 font-weight=600 letter-spacing=-0.25 testId="title"
            text "revu watches for review requests addressed to you and your teams, and runs AI reviews using the skill file mapped to each repository." font-size=14 line-height=1.5 color="light-dark(#596068, #9aa4ae)"
          column gap=12
            row gap=10 align-items="center"
              column width=20 height=20 border-radius=9999 background-color="light-dark(#11181c, #ffffff)" align-items="center" justify-content="center"
                text "1" font-size=11 font-weight=600 color="light-dark(#ffffff, #0b0f14)"
              text "Sign in with GitHub" font-size=13 font-weight=500
            row gap=10 align-items="center"
              column width=20 height=20 border-radius=9999 border-style="solid" border-width=1 border-color="light-dark(#d7dbdf, #30363d)" align-items="center" justify-content="center"
                text "2" font-size=11 font-weight=600 color="light-dark(#596068, #9aa4ae)"
              text "Choose teams to watch" font-size=13 color="light-dark(#596068, #9aa4ae)"
            row gap=10 align-items="center"
              column width=20 height=20 border-radius=9999 border-style="solid" border-width=1 border-color="light-dark(#d7dbdf, #30363d)" align-items="center" justify-content="center"
                text "3" font-size=11 font-weight=600 color="light-dark(#596068, #9aa4ae)"
              text "Add a default review skill" font-size=13 color="light-dark(#596068, #9aa4ae)"
          column gap=12
            match device
              case some(d)
                match browser
                  case some(b)
                    when b.ok
                      text "GitHub opened in your browser — approve revu there and come back." font-size=13 font-weight=500
                      button press=openBrowser class=Outline align-self="flex-start" testId="open-browser"
                        text "Open GitHub again"
                    else
                      text b.error class=Error testId="browser-error"
                  case none
                    box
                column class=Card testId="device-code"
                  text "Or enter this code at github.com/login/device" class=Tertiary
                  text d.userCode font-family="ui-monospace" font-size=18 font-weight=600 letter-spacing=2 testId="user-code"
                  button press=openLink(d.verificationUri) class=Ghost height=24 padding-left=0 padding-right=0 align-self="flex-start" color="light-dark(#0072DE, #4aa8ff)" font-size=12 testId="verification-link"
                    text "Open github.com/login/device ↗"
                  when d.error != ""
                    text d.error class=Error testId="device-error"
                  when codeExpired
                    text "The code expired; start again." class=Error testId="grant-status"
                  else
                    match grant
                      case some(g)
                        text g.status == "ok" ? `Signed in as ${g.login}` : g.error != "" ? g.error : "Waiting for approval…" class=Tertiary testId="grant-status"
                      case none
                        text "Waiting for approval…" class=Tertiary testId="grant-status"
                button press=cancelSignIn class=Ghost testId="cancel-sign-in"
                  text "Cancel"
              case none
                button press=startSignIn class=Primary testId="sign-in"
                  Icon(name="log-in", size=16, color="light-dark(#ffffff, #0b0f14)")
                  text "Continue with GitHub"
                column class=Card
                  text "Opens GitHub in your browser to approve revu. A one-time code is offered as a fallback." class=Tertiary
                when session.error != ""
                  text session.error class=Error testId="error"
          text "Requests the notifications, repo and read:user scopes. The token is stored in the macOS Keychain." font-size=12 line-height=1.5 color="light-dark(#687076, #6e7781)"

      // ---- 1b Popover — pending requests --------------------------------
      when signedIn and screen == "inbox"
        column flex=1 min-height=0 testId="inbox-screen"
          row class=Header
            text "Review requests" class=HeaderTitle testId="title"
            row gap=4
              button press=refreshNow class=IconBtn testId="refresh" aria-label="Refresh"
                Icon(name="refresh", size=15, color=(pending(inbox) ? "light-dark(#c9d1d9, #484f58)" : "light-dark(#596068, #9aa4ae)"))
              button press=openSettings class=IconBtn testId="open-settings" aria-label="Settings"
                Icon(name="settings", size=15, color="light-dark(#596068, #9aa4ae)")
          row padding-left=16 padding-right=16 padding-bottom=10 gap=4
            button press=setFilter("all") class=(filter == "all" ? ChipOn : Chip) testId="filter-all"
              text "All"
              text `${inbox.total}` color="light-dark(#687076, #6e7781)"
            button press=setFilter("mine") class=(filter == "mine" ? ChipOn : Chip) testId="filter-mine"
              text "You"
              text `${inbox.mineCount}` color="light-dark(#687076, #6e7781)"
            button press=setFilter("teams") class=(filter == "teams" ? ChipOn : Chip) testId="filter-teams"
              text "Teams"
              text `${inbox.teamCount}` color="light-dark(#687076, #6e7781)"
          box class=Divider
          when notifications.available and notifications.permission != "granted"
            row padding-left=16 padding-right=16 padding-top=8 padding-bottom=8 gap=8 align-items="center" background-color="light-dark(#f9fafb, #111418)"
              text "Get a banner when a review is requested." class=Secondary flex=1
              button press=askPermission class=OutlineSm testId="ask-permission"
                text "Allow notifications"
            box class=Divider
          when inbox.error != ""
            text inbox.error class=Error padding-left=16 padding-right=16 padding-top=8 testId="error"
          scroll flex=1 min-height=0
            column padding-bottom=6
              when filter != "teams"
                text "Requested from you" class=SectionLabel padding-top=10 padding-left=16 padding-right=16 padding-bottom=4
                each r in inbox.mine key=r.id
                  ReviewRow(r=r, press=openPr(r.id, r.owner, r.name, `${r.number}`))
                when inbox.ready and inbox.mineCount == 0
                  text "Nothing waiting on you." class=Tertiary padding-left=16 padding-top=6 padding-bottom=6 testId="empty-mine"
              when filter != "mine"
                text "Requested from teams" class=SectionLabel padding-top=12 padding-left=16 padding-right=16 padding-bottom=4
                each r in inbox.team key=r.id
                  ReviewRow(r=r, press=openPr(r.id, r.owner, r.name, `${r.number}`))
                when inbox.ready and inbox.teamCount == 0
                  text "No team requests." class=Tertiary padding-left=16 padding-top=6 padding-bottom=6 testId="empty-team"
              when not inbox.ready
                column testId="loading"
                  row class=Row
                    box class=Dot background-color="light-dark(#eaecf0, #252932)"
                    column flex=1 gap=6
                      Skeleton(w="40%", h=11)
                      Skeleton(w="92%", h=13)
                      Skeleton(w="30%", h=11)
                  row class=Row
                    box class=Dot background-color="light-dark(#eaecf0, #252932)"
                    column flex=1 gap=6
                      Skeleton(w="36%", h=11)
                      Skeleton(w="78%", h=13)
                      Skeleton(w="26%", h=11)
          box class=Divider
          row padding-top=10 padding-right=16 padding-bottom=10 padding-left=16 justify-content="space-between" align-items="center"
            text (inbox.ready ? `Synced ${inbox.polledAt} · ${session.login}` : "Syncing…") class=Tertiary testId="synced"
            button press=openLink("https://github.com/pulls/review-requested") class=Ghost height=24 padding-left=0 padding-right=0 color="light-dark(#687076, #6e7781)" font-size=12 testId="open-github"
              text "Open on GitHub ↗"

      // ---- 1c Popover — PR quick look -----------------------------------
      when signedIn and screen == "pr"
        column flex=1 min-height=0 testId="pr-screen"
          row padding-top=12 padding-right=12 padding-bottom=8 padding-left=12 gap=6 align-items="center"
            button press=goBack class=IconBtn testId="back" aria-label="Back"
              Icon(name="chevron-left", size=16, color="light-dark(#596068, #9aa4ae)")
            text `${prOwner}/${prName} #${prNumber}` class=MonoLabel flex=1
            button press=openLink(detail.url) class=IconBtn color="light-dark(#596068, #9aa4ae)" font-size=13 testId="open-on-github"
              text "↗"
          when not detail.ready and detail.error == ""
            column flex=1 testId="pr-loading"
              column padding-left=16 padding-right=16 padding-bottom=14 gap=10
                Skeleton(w="88%", h=18)
                Skeleton(w="60%", h=18)
                row gap=8 align-items="center" padding-top=2
                  box width=18 height=18 border-radius=9999 background-color="light-dark(#eaecf0, #252932)"
                  Skeleton(w="70%", h=12)
              box class=Divider
              column padding=16 padding-top=12 padding-bottom=12 gap=10
                row gap=16 align-items="center"
                  text "Checks" class=Tertiary width=56
                  Skeleton(w="40%", h=12)
                row gap=16 align-items="center"
                  text "Changes" class=Tertiary width=56
                  Skeleton(w="55%", h=12)
                row gap=16 align-items="center"
                  text "Skill" class=Tertiary width=56
                  Skeleton(w="65%", h=12)
              box class=Divider
              column padding=16 padding-top=12 padding-bottom=12 gap=8
                text "Files" class=SectionLabel
                row justify-content="space-between" gap=12
                  Skeleton(w="72%", h=12)
                  Skeleton(w="12%", h=12)
                row justify-content="space-between" gap=12
                  Skeleton(w="64%", h=12)
                  Skeleton(w="12%", h=12)
                row justify-content="space-between" gap=12
                  Skeleton(w="80%", h=12)
                  Skeleton(w="12%", h=12)
                row justify-content="space-between" gap=12
                  Skeleton(w="58%", h=12)
                  Skeleton(w="12%", h=12)
              box class=Divider
              column padding=16 padding-top=12 padding-bottom=12 gap=8
                text "Description" class=SectionLabel
                Skeleton(w="100%", h=12)
                Skeleton(w="94%", h=12)
                Skeleton(w="76%", h=12)
                Skeleton(w="88%", h=12)
          when not detail.ready and detail.error != ""
            column padding=16 gap=8
              text "The pull request could not be read" font-size=16 font-weight=600
              text detail.error class=Error testId="pr-error"
          when detail.ready
            scroll flex=1 min-height=0
              column
                column padding-left=16 padding-right=16 padding-bottom=14 gap=10
                  text detail.title font-size=16 font-weight=600 line-height=1.35 letter-spacing=-0.15 testId="pr-title"
                  row gap=8 align-items="center"
                    when detail.authorAvatar != ""
                      image detail.authorAvatar width=18 height=18 border-radius=9999 object-fit="cover" flex-shrink=0 aria-label="" testId="author-avatar"
                    else
                      box width=18 height=18 border-radius=9999 background-color="light-dark(#d7dbdf, #30363d)" flex-shrink=0
                    text `${detail.author} wants to merge ${detail.headRef} into ${detail.baseRef}` class=Secondary line-clamp=1
                box class=Divider
                column padding=16 padding-top=12 padding-bottom=12 gap=8
                  row gap=16 align-items="center"
                    text "Checks" class=Tertiary width=56
                    row gap=6 align-items="center"
                      box width=8 height=8 border-radius=9999 background-color=(detail.ci == "pass" ? "light-dark(rgb(9, 141, 72), #4ade80)" : detail.ci == "fail" ? "light-dark(rgb(207, 34, 46), #ff7a7a)" : detail.ci == "run" ? "rgb(255, 138, 76)" : "light-dark(#c9d1d9, #484f58)")
                      text detail.ciLabel font-size=12 testId="pr-checks"
                  row gap=16 align-items="center"
                    text "Changes" class=Tertiary width=56
                    row gap=4 class=Mono
                      text `${detail.files} files ·`
                      text `+${detail.additions}` color="light-dark(rgb(9, 141, 72), #4ade80)"
                      text `−${detail.deletions}` color="light-dark(rgb(207, 34, 46), #ff7a7a)"
                  row gap=16 align-items="center"
                    text "Skill" class=Tertiary width=56
                    row gap=6 align-items="center"
                      Icon(name="file-text", size=13, color="light-dark(#687076, #6e7781)")
                      text `${detail.skill}.md` class=Mono
                      text `· matched ${detail.skillRule}` class=Tertiary testId="pr-skill"
                box class=Divider
                column padding=16 padding-top=12 padding-bottom=12 gap=6
                  text "Files" class=SectionLabel
                  each f in detail.changed key=f.path
                    row justify-content="space-between" gap=12 class=Mono line-height=1.6
                      text f.path color="light-dark(#596068, #9aa4ae)" line-clamp=1 flex=1 min-width=0
                      row gap=4 flex-shrink=0
                        text `+${f.additions}` color="light-dark(rgb(9, 141, 72), #4ade80)"
                        text `−${f.deletions}` color="light-dark(rgb(207, 34, 46), #ff7a7a)"
                  when detail.ready and detail.files > length(detail.changed)
                    text `… and ${detail.files - length(detail.changed)} more` class=Tertiary
                box class=Divider
                column padding=16 padding-top=12 padding-bottom=12 gap=6
                  text "Description" class=SectionLabel
                  when detail.body == ""
                    text "(no description)" class=Secondary testId="pr-body"
                  else
                    text detail.body markup="markdown" width="100%" font-size=13 line-height="20px" color="light-dark(#596068, #9aa4ae)" testId="pr-body"
          box class=Divider
          row padding=12 padding-left=16 padding-right=16 gap=8
            button press=runReview class=PrimarySm flex=1 disabled=(not detail.ready or not sidecar.reachable) opacity=(detail.ready ? 1 : 0.5) testId="run-review"
              Icon(name="sparkles", size=14, color="light-dark(#ffffff, #0b0f14)")
              text (sidecar.reachable ? "Run AI review" : "Sidecar offline")
            button press=openLink(`${detail.url}/files`) class=Outline disabled=(not detail.ready) opacity=(detail.ready ? 1 : 0.5) testId="open-diff"
              text "Open diff"

      // ---- 1d / 1e Popover — AI review in progress, then the results -----
      when signedIn and screen == "review"
        column flex=1 min-height=0 testId="review-screen"
          row padding-top=12 padding-right=12 padding-bottom=8 padding-left=12 gap=6 align-items="center"
            button press=goBack class=IconBtn testId="back" aria-label="Back"
              Icon(name="chevron-left", size=16, color="light-dark(#596068, #9aa4ae)")
            text `${prOwner}/${prName} #${prNumber}` class=MonoLabel flex=1
            when job.ready
              row gap=6 align-items="center"
                Icon(name="file-text", size=13, color="light-dark(#687076, #6e7781)")
                text `${job.skill}.md · ${elapsedNow.text}` class=Tertiary
          when not job.ready
            column padding=16 gap=6
              row gap=10 align-items="center"
                box width=14 height=14 border-radius=9999 border-style="solid" border-width=2 border-color="light-dark(#d7dbdf, #30363d)" border-top-color="light-dark(#11181c, #e6edf3)" box-sizing="border-box" animation="spin 900ms linear infinite"
                text "Starting the review…" font-size=16 font-weight=600
              match started
                case some(s)
                  when s.error != ""
                    text s.error class=Error testId="start-error"
                case none
                  text "Asking the sidecar." class=Secondary
          when job.ready and reviewing
            column flex=1 min-height=0
              column padding-left=16 padding-right=16 padding-bottom=16 gap=6
                text `Reviewing with ${job.skill}.md` font-size=16 font-weight=600 letter-spacing=-0.15 testId="review-title"
                text `${job.agent == "codex" ? "Codex CLI" : "Claude Code"} reads the pull request through gh; nothing is checked out. You can go back to the list.` class=Secondary
              row padding-left=16 padding-right=16 padding-bottom=16 width="100%" box-sizing="border-box"
                row flex=1 height=4 border-radius=2 background-color="light-dark(#eaecf0, #252932)" overflow="hidden" testId="progress-track"
                  box height=4 border-radius=2 background-color="light-dark(#11181c, #e6edf3)" width=`${job.progress}%` testId="progress-fill"
              box class=Divider
              column padding=16 padding-top=12 padding-bottom=12 gap=10
                Step(label="Queued with the sidecar", state=(job.step > 0 ? "done" : "active"), meta="")
                Step(label=`Starting ${job.agent == "codex" ? "codex exec" : "claude -p"}`, state=(job.step > 1 ? "done" : job.step == 1 ? "active" : "pending"), meta="")
                Step(label=`Loaded skill ${job.skill}.md`, state=(job.step > 2 ? "done" : job.step == 2 ? "active" : "pending"), meta="")
                Step(label="Reading the diff and context via gh", state=(job.step > 3 ? "done" : job.step == 3 ? "active" : "pending"), meta=(job.step == 3 ? `${job.calls} calls` : ""))
                Step(label="Drafting comments", state=(job.step == 4 ? "active" : "pending"), meta="")
              column background-color="light-dark(#11181c, #0f1318)" padding=12 padding-left=16 padding-right=16 gap=2 min-height=64
                each line in job.log key=line
                  text line font-family="ui-monospace" font-size=11 line-height=1.7 color="light-dark(#c9d1d9, #9aa4ae)" line-clamp=1
                when length(job.log) == 0
                  text "waiting for output…" font-family="ui-monospace" font-size=11 line-height=1.7 color="light-dark(#687076, #6e7781)"
                when elapsedNow.quiet >= 20
                  row gap=8 align-items="center" padding-top=4
                    box width=10 height=10 border-radius=9999 border-style="solid" border-width=1.5 border-color="light-dark(#484f58, #484f58)" border-top-color="light-dark(#c9d1d9, #9aa4ae)" box-sizing="border-box" animation="spin 900ms linear infinite"
                    text `quiet for ${elapsedNow.quietText} — the agent is reading or thinking` font-family="ui-monospace" font-size=11 line-height=1.7 color="light-dark(#687076, #9aa4ae)" testId="quiet"
              box class=Divider
              row padding=12 padding-left=16 padding-right=16 justify-content="space-between" align-items="center"
                text `Elapsed ${elapsedNow.text}` class=Tertiary testId="elapsed"
                button press=cancelReview class=Outline height=28 testId="cancel-review"
                  text "Cancel"
          when job.ready and job.status == "failed"
            column padding=16 gap=8 testId="review-failed"
              text "The review did not run" font-size=16 font-weight=600
              text job.error class=Error
              text "Pick the agent in Settings ▸ Model; it must be installed and signed in." class=Secondary
              button press=goBack class=Outline align-self="flex-start"
                text "Back"
          when job.ready and job.status == "done"
            column padding=16 gap=12 testId="review-results"
              column class=Card gap=8
                row gap=8 align-items="center"
                  column width=14 height=14 border-radius=9999 background-color="light-dark(rgb(9, 141, 72), #4ade80)" align-items="center" justify-content="center"
                    text "✓" color="#fff" font-size=9 font-weight=700 line-height="9px"
                  text "Review ready" font-size=15 font-weight=600
                text `${length(job.comments)} ${length(job.comments) == 1 ? "finding" : "findings"} · suggested ${job.verdict == "APPROVE" ? "approve" : job.verdict == "REQUEST_CHANGES" ? "request changes" : "comment"}` class=Secondary
                text (job.summary == "" ? "The agent returned no summary." : job.summary) markup="markdown" width="100%" font-size=13 line-height="20px" color="light-dark(#596068, #9aa4ae)" line-clamp=6 testId="summary"
              button press=openReviewWindow class=PrimarySm testId="open-review-window"
                text "Open the review window"
              text "Pick the comments to post there; nothing goes to GitHub until you post." class=Tertiary
              button press=goBack class=Ghost align-self="flex-start"
                text "Back to the list"

      // ---- 1e Review window — pick comments to post ----------------------
      when signedIn and screen == "review-window"
        column flex=1 min-height=0 testId="review-window"
          row height=44 padding-left=80 padding-right=14 gap=14 align-items="center" border-bottom-style="solid" border-bottom-width=1 border-color="light-dark(#e1e4e8, #1f242c)" background-color="light-dark(#f9fafb, #111418)" flex-shrink=0
            text (job.title == "" ? `${job.repo} #${job.number}` : job.title) font-size=13 font-weight=600 line-clamp=1 flex-shrink=1
            text `${job.repo} #${job.number}` class=MonoLabel flex-shrink=0
            box flex=1
            text `${job.agent == "codex" ? "codex" : "claude"} · ${job.skill}.md · ${job.elapsed}` class=Tertiary flex-shrink=0
          when not job.ready
            column padding=20 gap=8
              Skeleton(w="60%", h=14)
              Skeleton(w="90%", h=12)
              Skeleton(w="80%", h=12)
          when job.ready and job.status != "done"
            column padding=20 gap=8
              text (job.status == "failed" ? "The review did not run" : "The review is still running") font-size=16 font-weight=600
              text (job.status == "failed" ? job.error : "Watch the popover; this window fills in when it finishes.") class=Secondary
          when job.ready and job.status == "done"
            row flex=1 min-height=0
              column width=320 flex-shrink=0 border-right-style="solid" border-right-width=1 border-color="light-dark(#e1e4e8, #1f242c)" min-height=0
                scroll flex=1 min-height=0
                  column
                    column padding=16 gap=8 border-bottom-style="solid" border-bottom-width=1 border-color="light-dark(#eaecf0, #171b21)"
                      text "Summary" class=SectionLabel
                      text (job.summary == "" ? "The agent returned no summary." : job.summary) markup="markdown" width="100%" font-size=13 line-height="20px" color="light-dark(#596068, #9aa4ae)" line-clamp=8 testId="summary"
                    row padding=16 padding-top=12 padding-bottom=6 justify-content="space-between" align-items="center"
                      text "Findings" class=SectionLabel
                      text `${job.chosenCount} of ${length(job.comments)} selected` class=Tertiary testId="chosen-count"
                    each c in job.comments key=`${c.index}`
                      row class=Row gap=10 background-color=(selectedFinding == c.index ? "light-dark(#f0f1f2, #1d2128)" : "transparent")
                        button press=toggleComment(c.index) width=16 height=16 border-radius=4 flex-shrink=0 margin-top=1 align-items="center" justify-content="center" border-style="solid" border-width=1 border-color=(c.chosen ? "light-dark(#11181c, #e6edf3)" : "light-dark(#d7dbdf, #30363d)") background-color=(c.chosen ? "light-dark(#11181c, #e6edf3)" : "light-dark(#ffffff, #0b0f14)") padding=0 disabled=job.posted testId=`choose-${c.index}` aria-label=`Include comment ${c.index + 1}`
                          when c.chosen
                            text "✓" color="light-dark(#ffffff, #0b0f14)" font-size=10 font-weight=700
                        button press=selectFinding(c.index) flex=1 min-width=0 gap=4 background-color="transparent" border-width=0 padding=0 text-align="left" display="flex" flex-direction="column" align-items="stretch"
                          row gap=6 align-items="center"
                            text c.severity class=Tag text-transform="uppercase" background-color=(c.severity == "critical" ? "light-dark(rgb(255, 220, 220), rgba(207, 34, 46, 0.18))" : c.severity == "design" ? "light-dark(rgb(255, 244, 194), rgba(255, 210, 44, 0.16))" : c.severity == "suggestion" ? "light-dark(rgb(219, 231, 255), rgba(33, 136, 255, 0.18))" : "light-dark(#f5f5f7, #161a20)") color=(c.severity == "critical" ? "light-dark(rgb(207, 34, 46), #ff7a7a)" : c.severity == "design" ? "light-dark(#8a6d00, #ffd36b)" : c.severity == "suggestion" ? "light-dark(#0072DE, #4aa8ff)" : "light-dark(#596068, #9aa4ae)")
                            text `${c.path}:${c.line}` font-family="ui-monospace" font-size=11 color="light-dark(#687076, #6e7781)" line-clamp=1 flex=1 min-width=0
                          text c.title font-size=13 font-weight=500 line-height=1.35 line-clamp=2
                    when length(job.comments) == 0
                      text (job.hasResult ? "No comments: the agent found nothing to say." : "The agent left no findings JSON; its output is in the popover.") class=Tertiary padding-left=16 padding-bottom=12
              column flex=1 min-width=0 min-height=0
                scroll flex=1 min-height=0
                  each c in job.comments key=`detail-${c.index}`
                    when c.index == selectedFinding
                      column padding=20 padding-left=24 padding-right=24 gap=14
                        row gap=8 align-items="center"
                          text c.severity class=Tag text-transform="uppercase" background-color=(c.severity == "critical" ? "light-dark(rgb(255, 220, 220), rgba(207, 34, 46, 0.18))" : c.severity == "design" ? "light-dark(rgb(255, 244, 194), rgba(255, 210, 44, 0.16))" : c.severity == "suggestion" ? "light-dark(rgb(219, 231, 255), rgba(33, 136, 255, 0.18))" : "light-dark(#f5f5f7, #161a20)") color=(c.severity == "critical" ? "light-dark(rgb(207, 34, 46), #ff7a7a)" : c.severity == "design" ? "light-dark(#8a6d00, #ffd36b)" : c.severity == "suggestion" ? "light-dark(#0072DE, #4aa8ff)" : "light-dark(#596068, #9aa4ae)")
                          text `${c.path}:${c.line}` font-family="ui-monospace" font-size=12 color="light-dark(#596068, #9aa4ae)" line-clamp=1
                        text c.title font-size=18 font-weight=600 letter-spacing=-0.2 line-height=1.3
                        when length(c.hunk) > 0
                          column border-style="solid" border-width=1 border-color="light-dark(#eaecf0, #1f242c)" border-radius=8 overflow="hidden" font-family="ui-monospace" font-size=12 testId="hunk"
                            each l in c.hunk key=`${l.oldNo}:${l.newNo}:${l.text}`
                              when l.oldNo == -1 and l.newNo == -1
                                text l.text padding-top=6 padding-bottom=6 padding-left=12 padding-right=12 background-color="light-dark(#f9fafb, #111418)" color="light-dark(#687076, #6e7781)" font-size=11 border-bottom-style="solid" border-bottom-width=1 border-color="light-dark(#eaecf0, #171b21)"
                              else
                                row background-color=(l.kind == "add" ? "light-dark(rgb(220, 255, 228), rgba(9, 141, 72, 0.18))" : l.kind == "del" ? "light-dark(rgb(255, 220, 220), rgba(207, 34, 46, 0.18))" : "transparent") border-left-style="solid" border-left-width=2 border-left-color=(l.target ? "light-dark(rgb(207, 34, 46), #ff7a7a)" : "transparent")
                                  text (l.newNo == -1 ? `${l.oldNo}` : `${l.newNo}`) width=40 text-align="right" padding-right=10 color="light-dark(#c9d1d9, #484f58)" line-height=1.7 flex-shrink=0
                                  text `${l.kind == "add" ? "+" : l.kind == "del" ? "−" : " "} ${l.text}` white-space="pre" line-clamp=1 line-height=1.7 padding-left=8 flex=1 min-width=0
                        column gap=6
                          text "Comment to post" class=Tertiary
                          column border-style="solid" border-width=1 border-color="light-dark(#e1e4e8, #1f242c)" border-radius=6 padding=12
                            text c.body markup="markdown" width="100%" font-size=13 line-height="20px" color="light-dark(#11181c, #e6edf3)"
                  when length(job.comments) == 0
                    text "Nothing to show." class=Tertiary padding=20
                row padding=12 padding-left=24 padding-right=24 gap=10 align-items="center" background-color="light-dark(#f9fafb, #111418)" border-top-style="solid" border-top-width=1 border-color="light-dark(#e1e4e8, #1f242c)" flex-shrink=0
                  select value=(verdict == "" ? job.verdict : verdict) change=setVerdict disabled=job.posted testId="verdict" aria-label="Verdict" height=32 font-size=13
                    option "Request changes" value="REQUEST_CHANGES"
                    option "Comment" value="COMMENT"
                    option "Approve" value="APPROVE"
                  text (job.posted ? `Staged ${job.postedCount} as a pending review` : "Posted as a pending review from you") class=Tertiary flex=1 line-clamp=2
                  match postResult
                    case some(p)
                      when p.error != ""
                        text p.error class=Error line-clamp=2 testId="post-error"
                    case none
                      box
                  when job.posted
                    button press=openLink(job.postedUrl) class=PrimarySm testId="open-pending"
                      text "Finish on GitHub ↗"
                  else
                    button press=postComments class=PrimarySm disabled=(posting or job.chosenCount == 0 or not job.hasResult) testId="post-comments"
                      text (posting ? "Posting…" : `Post ${job.chosenCount} ${job.chosenCount == 1 ? "comment" : "comments"}`)

      // ---- 1f Settings — skills mapped by repository ---------------------
      when signedIn and screen == "settings"
        column flex=1 min-height=0 testId="settings-screen"
          row height=44 padding-right=12 padding-left=(wide ? 80 : 12) gap=6 align-items="center" border-bottom-style="solid" border-bottom-width=1 border-color="light-dark(#e1e4e8, #1f242c)" background-color="light-dark(#f9fafb, #111418)" flex-shrink=0
            when not wide
              button press=goBack class=IconBtn testId="back" aria-label="Back"
                Icon(name="chevron-left", size=16, color="light-dark(#596068, #9aa4ae)")
            row flex=1 justify-content="center" gap=4 padding-right=(wide ? 52 : 0)
              button press=setSettingsTab("general") class=(settingsTab == "general" ? TabOn : Tab) testId="tab-general"
                text "General"
              button press=setSettingsTab("accounts") class=(settingsTab == "accounts" ? TabOn : Tab) testId="tab-accounts"
                text "Accounts"
              button press=setSettingsTab("skills") class=(settingsTab == "skills" ? TabOn : Tab) testId="tab-skills"
                text "Skills"
              button press=setSettingsTab("model") class=(settingsTab == "model" ? TabOn : Tab) testId="tab-model"
                text "Model"
            box width=28
          scroll flex=1 min-height=0
            when settingsTab == "general"
              column padding=16 gap=12
                text "General" class=SectionLabel
                row justify-content="space-between" align-items="center"
                  text "Poll GitHub" font-size=13
                  text "every 60 s" class=Secondary
                row justify-content="space-between" align-items="center"
                  text "Notifications" font-size=13
                  text (notifications.available ? notifications.permission : "unavailable here") class=Secondary testId="notification-status"
                when notifications.available and notifications.permission != "granted"
                  button press=askPermission class=Outline align-self="flex-start" testId="ask-permission"
                    text "Allow notifications"
                row justify-content="space-between" align-items="center"
                  text "AI review sidecar" font-size=13
                  text (sidecar.reachable ? `ready · runner ${sidecar.runner}` : "offline") class=Secondary testId="sidecar-status"
            when settingsTab == "accounts"
              column padding=16 gap=12
                text "GitHub" class=SectionLabel
                row justify-content="space-between" align-items="center"
                  column gap=2
                    text session.login font-size=13 font-weight=500 testId="signed-in-as"
                    text "Token in the macOS Keychain · scopes notifications, repo, read:user" class=Tertiary
                  button press=doSignOut class=Outline testId="sign-out"
                    text "Sign out"
            when settingsTab == "model"
              column padding=16 gap=12 max-width=560
                text "Local agent" class=SectionLabel
                text "Reviews run on the agent CLI you already use and are signed in to. Nothing is checked out: the agent reads the pull request through gh." font-size=12 line-height=1.5 color="light-dark(#687076, #6e7781)"
                button press=chooseAgent("claude") class=Card display="flex" flex-direction="row" gap=12 align-items="center" border-color=(agents.current == "claude" ? "light-dark(#11181c, #e6edf3)" : "light-dark(#e1e4e8, #1f242c)") text-align="left" testId="agent-claude"
                  box width=16 height=16 border-radius=9999 border-style="solid" border-width=(agents.current == "claude" ? 5 : 1) border-color=(agents.current == "claude" ? "light-dark(#11181c, #e6edf3)" : "light-dark(#d7dbdf, #30363d)") background-color="light-dark(#ffffff, #0b0f14)" flex-shrink=0
                  column flex=1 gap=2
                    text "Claude Code" font-size=13 font-weight=500
                    text (agents.claudeAvailable ? `claude -p · ${agents.claudePath}` : "not installed — npm i -g @anthropic-ai/claude-code, then claude login") class=Tertiary line-clamp=1
                button press=chooseAgent("codex") class=Card display="flex" flex-direction="row" gap=12 align-items="center" border-color=(agents.current == "codex" ? "light-dark(#11181c, #e6edf3)" : "light-dark(#e1e4e8, #1f242c)") text-align="left" testId="agent-codex"
                  box width=16 height=16 border-radius=9999 border-style="solid" border-width=(agents.current == "codex" ? 5 : 1) border-color=(agents.current == "codex" ? "light-dark(#11181c, #e6edf3)" : "light-dark(#d7dbdf, #30363d)") background-color="light-dark(#ffffff, #0b0f14)" flex-shrink=0
                  column flex=1 gap=2
                    text "Codex CLI" font-size=13 font-weight=500
                    text (agents.codexAvailable ? `codex exec · ${agents.codexPath}` : "not installed — npm i -g @openai/codex, then codex login") class=Tertiary line-clamp=1
                text "Model" class=SectionLabel padding-top=8
                text "The alias or name the CLI accepts (Claude: opus, sonnet, or a full name; Codex: as `codex -m`). Empty uses the CLI's own default." font-size=12 line-height=1.5 color="light-dark(#687076, #6e7781)"
                row gap=6 align-items="center"
                  input value=(modelDraft == "" ? agents.model : modelDraft) input=setModelDraft autocapitalize="none" autocorrect="off" spellcheck="false" placeholder="opus" class=Field flex=1 testId="model"
                  button press=saveModel class=OutlineSm height=30 disabled=(modelDraft == "" or modelDraft == agents.model) testId="save-model"
                    text "Save"
                when not sidecar.reachable
                  text "The sidecar is offline; availability is unknown." class=Error
            when settingsTab == "skills"
              row flex-wrap="wrap" align-items="flex-start" min-height="100%" width="100%" box-sizing="border-box"
                column width=(wide ? 300 : "100%") flex-shrink=0 border-right-style="solid" border-right-width=(wide ? 1 : 0) border-color="light-dark(#e1e4e8, #1f242c)" min-height=(wide ? "100%" : 0) testId="rules-pane"
                  column padding=16 padding-bottom=8 gap=8
                    row justify-content="space-between" align-items="center"
                      text "Repository rules" class=SectionLabel
                    text "First match wins. Patterns support *." font-size=12 line-height=1.5 color="light-dark(#687076, #6e7781)"
                    each rule in skills.rules key=rule.pattern
                      row padding-top=8 padding-bottom=8 padding-left=8 padding-right=8 border-radius=6 gap=10 align-items="center" background-color=(rule.skill == skills.selected ? "light-dark(#eaecf0, #252932)" : "transparent")
                        column flex=1 min-width=0 gap=2
                          text rule.pattern font-family="ui-monospace" font-size=12 font-weight=500
                          text `→ ${rule.skill}.md` class=Tertiary
                        button press=removeRule(rule.pattern) class=IconBtn width=24 height=24 aria-label=`Remove rule ${rule.pattern}`
                          Icon(name="x", size=13, color="light-dark(#687076, #6e7781)")
                    row gap=6 align-items="center"
                      input value=newPattern input=setNewPattern autocapitalize="none" autocorrect="off" spellcheck="false" placeholder="owner/repo*" class=Field flex=1 testId="new-pattern"
                      input value=newSkill input=setNewSkill autocapitalize="none" autocorrect="off" spellcheck="false" placeholder="skill" class=Field flex=1 testId="new-skill"
                      button press=addRule class=OutlineSm height=30 disabled=(newPattern == "" or newSkill == "") testId="add-rule"
                        Icon(name="plus", size=13, color="light-dark(#11181c, #e6edf3)")
                    match rules
                      case some(r)
                        when r.error != ""
                          text r.error class=Error
                      case none
                        box
                  box class=Divider
                  column padding=16 padding-top=12 gap=8
                    text "Test a repository" class=Tertiary
                    input value=testRepo input=setTestRepo autocapitalize="none" autocorrect="off" spellcheck="false" placeholder="expo/orbit" class=Field testId="test-repo"
                    when testRepo != ""
                      row gap=4 class=Secondary
                        text "Uses"
                        text `${testMatch.skill}.md` class=Mono
                        text "via"
                        text testMatch.pattern class=Mono
                column flex=1 min-width=300 max-width="100%" overflow="hidden" testId="skill-pane"
                  row padding-top=12 padding-bottom=12 padding-left=20 padding-right=20 gap=10 align-items="center" border-bottom-style="solid" border-bottom-width=1 border-color="light-dark(#eaecf0, #252932)"
                    Icon(name="file-text", size=15, color="light-dark(#687076, #6e7781)")
                    row gap=6 flex-wrap="wrap"
                      each s in skills.skills key=s.name
                        button press=selectSkill(s.name) class=(s.name == skills.selected ? ChipOn : Chip) testId=`skill-${s.name}`
                          text `${s.name}.md`
                    when skillEditing
                      text "EDITED" class=Tag background-color="light-dark(rgb(255, 244, 194), rgba(255, 210, 44, 0.16))" color="light-dark(#8a6d00, #ffd36b)"
                    text (skills.error != "" ? skills.error : skills.reachable ? `Used by ${skills.usedBy}` : "sidecar offline") class=(skills.reachable ? Tertiary : Error) flex=1 text-align="right" line-clamp=1
                  when skills.selected != ""
                    when skillEditing
                      textarea value=skillDraft input=changeSkill font-family="ui-monospace" font-size=12 line-height=1.75 height=(wide ? 480 : 320) width="100%" box-sizing="border-box" padding=12 padding-left=14 border-width=0 background-color="light-dark(#fbfcfd, #0f1318)" color="light-dark(#11181c, #e6edf3)" testId="skill-editor"
                    else
                      column background-color="light-dark(#fbfcfd, #0f1318)" padding-top=12 padding-bottom=12 overflow="hidden" min-height=(wide ? 480 : 0)
                        each l in skills.lines key=l.n
                          row gap=0
                            text `${l.n}` font-family="ui-monospace" font-size=12 line-height=1.75 color="light-dark(#c9d1d9, #484f58)" width=44 text-align="right" padding-right=12 flex-shrink=0 border-right-style="solid" border-right-width=1 border-color="light-dark(#eaecf0, #252932)"
                            text l.text font-family="ui-monospace" font-size=12 line-height=1.75 color=(l.heading ? "light-dark(#0072DE, #4aa8ff)" : "light-dark(#11181c, #e6edf3)") font-weight=(l.heading ? 600 : 400) white-space="pre" line-clamp=1 flex=1 min-width=0 padding-left=14
                    row gap=10 align-items="center" padding=12 padding-left=20 padding-right=20 border-top-style="solid" border-top-width=1 border-color="light-dark(#e1e4e8, #1f242c)" background-color="light-dark(#f9fafb, #111418)"
                      text skills.path class=Tertiary flex=1 line-clamp=1
                      when skillEditing
                        button press=revertSkill class=Ghost height=30 testId="revert-skill"
                          text "Revert"
                        button press=saveSkill class=PrimarySm height=30 testId="save-skill"
                          text "Save"
                      else
                        button press=editSkill class=Outline height=30 testId="edit-skill"
                          text "Edit"
                    match saved
                      case some(s)
                        when s.error != ""
                          text s.error class=Error padding-left=20
                      case none
                        box
                        box

// A skeleton bar while data loads: a rounded block with a sweeping sheen.
component Skeleton
  props
    w: string
    h: number
  view
    box width=w height=h border-radius=4 background-color="light-dark(#eaecf0, #252932)" overflow="hidden" flex-shrink=0
      box width=160 height=h background-image="linear-gradient(90deg, rgba(255, 255, 255, 0), light-dark(rgba(255, 255, 255, 0.7), rgba(255, 255, 255, 0.08)), rgba(255, 255, 255, 0))" animation="shimmer 1.4s ease-in-out infinite"

// One step of a running review (design 1d): done → a green dot with a
// check, active → a spinner, pending → a faint ring.
component Step
  props
    label: string
    state: string
    meta: string
  view
    row gap=10 align-items="center" font-size=13
      column width=16 height=16 align-items="center" justify-content="center" flex-shrink=0
        when state == "done"
          column width=14 height=14 border-radius=9999 background-color="light-dark(rgb(9, 141, 72), #4ade80)" align-items="center" justify-content="center"
            text "✓" color="#fff" font-size=9 font-weight=700 line-height="9px"
        when state == "active"
          box width=14 height=14 border-radius=9999 border-style="solid" border-width=2 border-color="light-dark(#d7dbdf, #30363d)" border-top-color="light-dark(#11181c, #e6edf3)" box-sizing="border-box" animation="spin 900ms linear infinite"
        when state == "pending"
          box width=12 height=12 border-radius=9999 border-style="solid" border-width=1.5 border-color="light-dark(#d7dbdf, #30363d)" box-sizing="border-box"
      text label flex=1 color=(state == "done" ? "light-dark(#596068, #9aa4ae)" : state == "active" ? "light-dark(#11181c, #e6edf3)" : "light-dark(#687076, #6e7781)")
      when meta != ""
        text meta font-family="ui-monospace" font-size=12 color="light-dark(#687076, #6e7781)"

// Lucide icons (stroke 2, round caps), as in the design.
component Icon
  props
    name: string
    size: number
    color: string
  view
    svg width=size height=size viewBox="0 0 24 24" fill="none" flex-shrink=0
      when name == "git-pull-request"
        circle cx=18 cy=18 r=3 stroke=color stroke-width=2
        circle cx=6 cy=6 r=3 stroke=color stroke-width=2
        path d="M13 6h3a2 2 0 0 1 2 2v7" stroke=color stroke-width=2 stroke-linecap="round" stroke-linejoin="round"
        path d="M6 9v12" stroke=color stroke-width=2 stroke-linecap="round"
      when name == "refresh"
        path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8" stroke=color stroke-width=2 stroke-linecap="round" stroke-linejoin="round"
        path d="M21 3v5h-5" stroke=color stroke-width=2 stroke-linecap="round" stroke-linejoin="round"
        path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16" stroke=color stroke-width=2 stroke-linecap="round" stroke-linejoin="round"
        path d="M8 16H3v5" stroke=color stroke-width=2 stroke-linecap="round" stroke-linejoin="round"
      when name == "settings"
        path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" stroke=color stroke-width=2 stroke-linecap="round" stroke-linejoin="round"
        circle cx=12 cy=12 r=3 stroke=color stroke-width=2
      when name == "sparkles"
        path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z" stroke=color stroke-width=2 stroke-linecap="round" stroke-linejoin="round"
        path d="M20 3v4" stroke=color stroke-width=2 stroke-linecap="round"
        path d="M22 5h-4" stroke=color stroke-width=2 stroke-linecap="round"
        path d="M4 17v2" stroke=color stroke-width=2 stroke-linecap="round"
        path d="M5 18H3" stroke=color stroke-width=2 stroke-linecap="round"
      when name == "chevron-left"
        path d="m15 18-6-6 6-6" stroke=color stroke-width=2 stroke-linecap="round" stroke-linejoin="round"
      when name == "chevron-down"
        path d="m6 9 6 6 6-6" stroke=color stroke-width=2 stroke-linecap="round" stroke-linejoin="round"
      when name == "log-in"
        path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" stroke=color stroke-width=2 stroke-linecap="round" stroke-linejoin="round"
        path d="m10 17 5-5-5-5" stroke=color stroke-width=2 stroke-linecap="round" stroke-linejoin="round"
        path d="M15 12H3" stroke=color stroke-width=2 stroke-linecap="round"
      when name == "file-text"
        path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" stroke=color stroke-width=2 stroke-linecap="round" stroke-linejoin="round"
        path d="M14 2v4a2 2 0 0 0 2 2h4" stroke=color stroke-width=2 stroke-linecap="round" stroke-linejoin="round"
        path d="M10 9H8" stroke=color stroke-width=2 stroke-linecap="round"
        path d="M16 13H8" stroke=color stroke-width=2 stroke-linecap="round"
        path d="M16 17H8" stroke=color stroke-width=2 stroke-linecap="round"
      when name == "plus"
        path d="M5 12h14" stroke=color stroke-width=2 stroke-linecap="round"
        path d="M12 5v14" stroke=color stroke-width=2 stroke-linecap="round"
      when name == "x"
        path d="M18 6 6 18" stroke=color stroke-width=2 stroke-linecap="round"
        path d="m6 6 12 12" stroke=color stroke-width=2 stroke-linecap="round"

// One review-request row (design 1b).
component ReviewRow
  props
    r: Review
    press: action
  view
    button press=press class=Row testId=`pr-${r.id}`
      box class=Dot background-color=(r.ci == "pass" ? "light-dark(rgb(9, 141, 72), #4ade80)" : r.ci == "fail" ? "light-dark(rgb(207, 34, 46), #ff7a7a)" : r.ci == "run" ? "rgb(255, 138, 76)" : "light-dark(#c9d1d9, #484f58)")
      column flex=1 min-width=0 gap=3
        text (r.team == "" ? `${r.repo} #${r.number}` : `${r.repo} #${r.number} · ${r.team}`) class=MonoLabel
        text r.title font-size=13 font-weight=(r.unread ? 600 : 500) line-height=1.35 line-clamp=2
        text (r.unread ? `${r.ciLabel} · new` : r.ciLabel) class=Secondary
      row class=OutlineSm
        Icon(name="sparkles", size=13, color="light-dark(#11181c, #e6edf3)")
        text "Review"
