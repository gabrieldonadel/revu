// revu — GitHub review requests, on exact2 (windowed first; the menu bar item
// and notifications are capability asks, LLP 0003 in this repo's llp/).
// The data is app.ts: device-flow sign-in, polling, and seen-state.

routes nav
  tab home "/"
  notfound

shape Time
  epochAtZero: number

shape Session
  signedIn: bool
  login: string
  error: string

shape DeviceCode
  stamp: number
  ok: bool
  userCode: string
  verificationUri: string
  deviceCode: string
  expiresAt: number
  error: string

shape Grant
  stamp: number
  status: string
  login: string
  error: string

shape Review
  id: string
  repo: string
  number: number
  title: string
  url: string
  author: string
  requestedAt: string
  age: string
  unread: bool

shape Inbox
  ready: bool
  login: string
  unread: number
  total: number
  polledAt: string
  error: string
  reviews: list<Review>

shape SidecarStatus
  reachable: bool
  runner: string
  detail: string

shape NotifyStatus
  available: bool
  permission: string
  pending: number

shape Announced
  stamp: number
  count: number
  error: string

shape Actions
  stamp: number
  applied: list<string>

shape Seen
  stamp: number
  id: string

style Page
  width="100%" max-width=760 margin-left="auto" margin-right="auto" padding=24 box-sizing="border-box"
style Title
  font-size=28 font-weight=700
style Muted
  color="#6b7280" font-size=13
style Btn
  padding-top=8 padding-bottom=8 padding-left=14 padding-right=14 border-radius=8 border-style="solid" border-width=1 border-color="#111827" background-color="#111827" color="#ffffff" font-size=14
style BtnGhost
  padding-top=6 padding-bottom=6 padding-left=10 padding-right=10 border-radius=8 border-style="solid" border-width=1 border-color="#d1d5db" background-color="transparent" color="#111827" font-size=13
style Card
  padding=12 border-radius=10 background-color="#f3f4f6" margin-bottom=8 width="100%" box-sizing="border-box"
style Code
  font-size=40 font-weight=700 letter-spacing=4

component Revu
  state tick = 0
  state nowMs = 0

  // @ref exact2 LLP 1027.000.000 — the date is a host fact; now() is ms since launch.
  resource time = exactTime() as shape Time
  resource session = currentSession() as shape Session
  resource sidecar = sidecarStatus() as shape SidecarStatus
  resource notifications = notificationStatus() as shape NotifyStatus
  // Re-asked when the module announces a user's answer; the inbox depends on
  // its stamp so a "Mark read" from a banner shows at once.
  resource actions = notificationActions(nowMs) as shape Actions
  resource inbox = reviewRequests(session.login, nowMs, actions.stamp) as shape Inbox

  mutation device as shape DeviceCode refreshes session
  mutation grant as shape Grant refreshes session, inbox
  mutation seen as shape Seen refreshes inbox
  mutation signout as shape Session refreshes session, inbox
  mutation permission as shape NotifyStatus refreshes notifications
  mutation announced as shape Announced

  derive signedIn = session.signedIn
  derive granted = match grant { case some(g) => g.status == "ok", case none => false }

  action startSignIn writes device, grant, nowMs
    nowMs = time.epochAtZero + now()
    grant = none
    send device = deviceStart(nowMs)
  action cancelSignIn writes device, grant
    device = none
    grant = none
  action doSignOut writes signout, device, grant
    device = none
    grant = none
    send signout = signOut()
  action markRead(id: string) writes seen
    send seen = markSeen(id)
  action refreshNow writes nowMs, announced
    nowMs = time.epochAtZero + now()
    refresh inbox
    send announced = announceNew(nowMs)
  action askPermission writes permission
    send permission = requestNotificationPermission()
  // One 5s clock: while a device code is out and not yet granted, poll the
  // grant; once signed in, refresh the inbox every 12th tick (60s).
  action clock writes tick, grant, nowMs, announced
    tick = tick + 1
    nowMs = time.epochAtZero + now()
    if signedIn
      if tick % 12 == 0
        refresh inbox
      if tick % 12 == 1
        send announced = announceNew(nowMs)
    else
      match device
        case some(d)
          if d.ok and not granted
            send grant = devicePoll(d.deviceCode, nowMs)
        case none
          tick = tick

  task poll mount
    every(5000, clock)

  view
    column class=Page
      revu-notifier width=0 height=0 testId="notifier"
      row justify-content="space-between" align-items="center"
        text "revu" class=Title testId="title"
        text signedIn ? `${inbox.unread} unread · ${inbox.total} pending` : "not signed in" class=Muted testId="summary"

      when not signedIn
        match device
          case some(d)
            column gap=8 testId="device-code"
              text "Enter this code on GitHub:" class=Muted
              text d.userCode class=Code testId="user-code"
              link href=d.verificationUri color="#2563eb" font-size=13 testId="verification-link"
                text d.verificationUri
              when d.error != ""
                text d.error color="#b91c1c" font-size=13 testId="device-error"
              match grant
                case some(g)
                  text g.status == "ok" ? `Signed in as ${g.login}` : g.error != "" ? g.error : "Waiting for approval…" class=Muted testId="grant-status"
                case none
                  text "Waiting for approval…" class=Muted testId="grant-status"
              button press=cancelSignIn class=BtnGhost testId="cancel-sign-in"
                text "Cancel"
          case none
            column gap=8
              text "Sign in to see the pull requests waiting for your review." class=Muted
              button press=startSignIn class=Btn testId="sign-in"
                text "Sign in with GitHub"
              when session.error != ""
                text session.error color="#b91c1c" font-size=13 testId="error"

      when signedIn
        column gap=8
          row gap=8 align-items="center"
            text `Signed in as ${session.login} · polled ${inbox.polledAt}` class=Muted testId="signed-in-as"
            button press=refreshNow class=BtnGhost testId="refresh"
              text pending(inbox) ? "Refreshing…" : "Refresh"
            button press=doSignOut class=BtnGhost testId="sign-out"
              text "Sign out"
          when inbox.error != ""
            text inbox.error color="#b91c1c" font-size=13 testId="error"
          text sidecar.reachable ? `AI review: sidecar ready · runner ${sidecar.runner}` : "AI review: sidecar offline" class=Muted testId="sidecar-status"
          row gap=8 align-items="center"
            text notifications.available ? `Notifications: ${notifications.permission}` : "Notifications: unavailable here" class=Muted testId="notification-status"
            when notifications.available and notifications.permission != "granted"
              button press=askPermission class=BtnGhost testId="ask-permission"
                text "Allow notifications"
          when inbox.ready and inbox.total == 0
            text "No pending review requests." class=Muted testId="empty"
          each r in inbox.reviews key=r.id
            column class=Card testId=`pr-${r.id}`
              row justify-content="space-between" align-items="center"
                link href=r.url color="#111827" font-size=15 font-weight=r.unread ? 600 : 400
                  text `${r.unread ? "● " : ""}${r.repo}#${r.number} — ${r.title}`
                when r.unread
                  button press=markRead(r.id) class=BtnGhost
                    text "Mark read"
              text `${r.author} · requested ${r.age}` class=Muted
