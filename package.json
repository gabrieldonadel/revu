{
  "name": "revu",
  "private": true,
  "type": "module",
  "scripts": {
    "sidecar": "bun run sidecar/src/index.ts",
    "sidecar:dev": "bun --watch run sidecar/src/index.ts",
    "sidecar:typecheck": "bunx tsc --noEmit -p sidecar/tsconfig.json",
    "app:web": "bun revu-app/exact.mjs web",
    "app:mac": "bun revu-app/exact.mjs mac --run",
    "app:bundle": "cd revu-app && EXACT_APP_DIR=$PWD bun ../../exact2/host/apple/build.mjs revu-app-apple --bundle",
    "app:open": "open -n \"$(ls -d revu-app/target/clients/*/dev.donadel.revu/macos/revu.app | head -1)\""
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
